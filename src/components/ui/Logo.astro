---
import { bot } from '../../config/bot';

interface Props {
  withName?: boolean;
  image?: string;
  href?: string;
}

const { withName = true, image = '/me-avatar.png', href } = Astro.props;
---

<span class="logo">
  <img class="logo__image" src={image} alt="" width={32} height={32} />
  {
    withName &&
      (href !== undefined ? (
        <a class="logo__name logo__name--link" href={href}>
          {bot.name}
        </a>
      ) : (
        <span class="logo__name">{bot.name}</span>
      ))
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo__image {
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px -5px var(--glow);
  }

  .logo__name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .logo__name--link {
    transition: color var(--dur) var(--ease);
  }

  .logo__name--link:hover {
    color: var(--accent-text);
  }
</style>
