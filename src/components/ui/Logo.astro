---
import { bot } from '../../config/bot';

interface Props {
  withName?: boolean;
  image?: string;
}

const { withName = true, image = '/me.svg' } = Astro.props;
---

<span class="logo">
  <img class="logo__image" src={image} alt="" width={38} height={38} />
  {withName && <span class="logo__name">{bot.name}</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }

  .logo__image {
    width: 2.25rem;
    height: 2.25rem;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: var(--radius-sm);
    box-shadow: 0 4px 14px -5px var(--glow);
  }

  .logo__name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }
</style>
