---
import { commandCategories } from '../../types/command';
import { commands } from '../../data/commands';
import Icon from '../ui/Icon.astro';
import CommandCard from './CommandCard.astro';

const categories = commandCategories.map((name) => ({
  name,
  count: commands.filter((command) => command.category === name).length,
}));
---

<section class="explorer container" aria-label="Command explorer">
  <div class="toolbar">
    <div class="search">
      <Icon name="search" size={18} class="search__icon" />
      <label class="sr-only" for="command-search">Search commands</label>
      <input
        id="command-search"
        class="search__input"
        type="search"
        placeholder="Search commands…"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
    </div>

    <div class="filters" role="group" aria-label="Filter commands by category">
      <button
        type="button"
        class="filter is-active"
        data-filter
        data-category="All"
        aria-pressed="true"
      >
        All
        <span class="filter__count">{commands.length}</span>
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            class="filter"
            data-filter
            data-category={category.name}
            aria-pressed="false"
          >
            {category.name}
            <span class="filter__count">{category.count}</span>
          </button>
        ))
      }
    </div>

    <p class="result-count" data-result-count aria-live="polite">
      {commands.length} commands
    </p>
  </div>

  <h2 class="sr-only">All commands</h2>

  <ul class="grid" data-grid>
    {commands.map((command) => <CommandCard command={command} />)}
  </ul>

  <div class="empty" data-empty hidden>
    <span class="empty__icon" aria-hidden="true">
      <Icon name="search" size={24} />
    </span>
    <h2 class="empty__title">No commands found</h2>
    <p class="empty__desc">Try a different search term, or reset the filters.</p>
    <button type="button" class="btn btn--secondary btn--sm" data-reset>
      Reset filters
    </button>
  </div>
</section>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  const resultCount = document.querySelector<HTMLElement>('[data-result-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-empty]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-reset]');

  let activeCategory = 'All';

  const applyFilters = () => {
    const query = searchInput?.value.trim().toLowerCase() ?? '';
    let visible = 0;

    for (const card of cards) {
      const category = card.dataset.category ?? '';
      const haystack = card.dataset.search ?? '';
      const matchesCategory = activeCategory === 'All' || category === activeCategory;
      const matchesQuery = query === '' || haystack.includes(query);
      const show = matchesCategory && matchesQuery;

      card.hidden = !show;
      if (show) visible += 1;
    }

    if (resultCount) {
      resultCount.textContent = `${visible} command${visible === 1 ? '' : 's'}`;
    }
    if (emptyState) {
      emptyState.hidden = visible !== 0;
    }
    for (const filter of filters) {
      filter.setAttribute('aria-pressed', String(filter.dataset.category === activeCategory));
      filter.classList.toggle('is-active', filter.dataset.category === activeCategory);
    }
  };

  const syncUrl = () => {
    const query = searchInput?.value.trim() ?? '';
    const next = query ? `?name=${encodeURIComponent(query)}` : window.location.pathname;
    history.replaceState(null, '', next);
  };

  const revealName = (name: string) => {
    const target = cards.find(
      (card) => card.dataset.name?.toLowerCase() === name.toLowerCase(),
    );
    if (!target || target.hidden) return;
    target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    target.classList.add('cmd--target');
  };

  for (const filter of filters) {
    filter.addEventListener('click', () => {
      activeCategory = filter.dataset.category ?? 'All';
      applyFilters();
    });
  }

  searchInput?.addEventListener('input', () => {
    applyFilters();
    syncUrl();
  });

  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchInput.value !== '') {
      searchInput.value = '';
      applyFilters();
      syncUrl();
    }
  });

  resetButton?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'All';
    applyFilters();
    syncUrl();
    searchInput?.focus();
  });

  applyFilters();

  const requestedName = new URLSearchParams(window.location.search).get('name');
  if (requestedName) {
    if (searchInput) searchInput.value = requestedName;
    applyFilters();
    revealName(requestedName);
  }
</script>

<style>
  .explorer {
    margin-bottom: var(--section-y);
  }

  .toolbar {
    display: grid;
    gap: 1.15rem;
    margin-bottom: 2rem;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
  }

  :global(.search__icon) {
    position: absolute;
    left: 1rem;
    color: var(--text-faint);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    padding: 0.95rem 1.25rem 0.95rem 2.9rem;
    font-size: 1rem;
    color: var(--text);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    outline: none;
    transition:
      border-color var(--dur) var(--ease),
      background-color var(--dur) var(--ease-spring),
      box-shadow var(--dur) var(--ease);
    will-change: border-color, background-color, box-shadow;
    appearance: none;
  }

  .search__input::placeholder {
    color: var(--text-faint);
  }

  .search__input:hover {
    border-color: var(--border-strong);
  }

  .search__input:focus-visible {
    outline: none;
    background: var(--surface-2);
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--surface-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease),
      background-color var(--dur) var(--ease-spring),
      border-color var(--dur-fast) ease;
  }

  .filter:hover {
    color: var(--text);
    background: var(--surface-2);
    border-color: var(--border-strong);
  }

  .filter.is-active {
    color: var(--accent-fg);
    background: var(--accent);
    border-color: var(--accent);
  }

  .filter__count {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-faint);
    background: var(--surface-3);
    padding: 0.05rem 0.45rem;
    border-radius: var(--radius-full);
    transition: inherit;
  }

  .filter.is-active .filter__count {
    color: var(--accent-fg);
    background: rgb(255 255 255 / 0.22);
  }

  .result-count {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-faint);
  }

  .grid {
    display: grid;
    gap: 1.15rem;
    align-items: start;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 4rem 1.5rem;
    text-align: center;
    background: var(--surface-1);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
  }

  .empty__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    color: var(--text-faint);
    background: var(--surface-3);
    border-radius: var(--radius-full);
  }

  .empty__title {
    font-size: 1.25rem;
  }

  .empty__desc {
    font-size: 0.925rem;
    color: var(--text-muted);
  }

  .empty .btn {
    margin-top: 0.5rem;
  }

  @media (min-width: 768px) {
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem 1.25rem;
    }

    .search {
      flex: 1 1 20rem;
    }

    .filters {
      flex: 2 1 auto;
    }

    .result-count {
      flex: 0 0 auto;
      margin-left: auto;
    }

    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem;
    }
  }

  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
