---
import Icon from '../ui/Icon.astro';
import { formatDate } from '../../utils/format';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  updated?: string;
}

const { eyebrow, title, lead, updated } = Astro.props;
---

<header class="page-hero container container--narrow">
  <span class="eyebrow animate-in">{eyebrow}</span>
  <h1 class="page-title animate-in delay-1">{title}</h1>
  <p class="page-lead animate-in delay-2">{lead}</p>
  {
    updated && (
      <p class="meta-line animate-in delay-3">
        <Icon name="clock" size={15} />
        <span>
          Last updated{' '}
          <time datetime={updated}>{formatDate(updated)}</time>
        </span>
      </p>
    )
  }
</header>

<style>
  .page-hero {
    padding-top: clamp(3rem, 7vw, 4.5rem);
    margin-bottom: clamp(2.5rem, 6vw, 3.5rem);
  }
</style>
